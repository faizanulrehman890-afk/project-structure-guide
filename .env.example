# =============================================================================
# .env.example
# =============================================================================
# WHY THIS FILE EXISTS:
#   Apps often need settings that change between computers or contain SECRETS,
#   such as API keys, database passwords or the port to run on. These live in
#   a file called `.env`, which is listed in .gitignore and NEVER committed.
#
#   But then how does a new developer know which variables to set?
#   That's what THIS file is for: a TEMPLATE with fake, safe placeholder values.
#   It IS committed to Git so everyone can see what's needed.
#
# HOW TO USE IT:
#   1. Copy this file and name the copy `.env`:
#        cp .env.example .env        (macOS / Linux / Git Bash)
#        copy .env.example .env      (Windows Command Prompt)
#   2. Open `.env` and replace the placeholder values with real ones.
#   3. Never share or commit your `.env` file!
#
# FORMAT RULES:
#   - One variable per line: NAME=value
#   - No spaces around the = sign
#   - Names are UPPERCASE_WITH_UNDERSCORES by convention
#   - Use quotes if the value contains spaces: APP_NAME="My Cool App"
#
# READING THEM IN CODE (Node.js):
#   process.env.PORT
#   (Node 20.6+ can load the file with: node --env-file=.env src/index.js)
# =============================================================================


# -----------------------------------------------------------------------------
# App settings
# -----------------------------------------------------------------------------

# Which mode the app runs in. Common values: development, test, production
NODE_ENV=development

# The port number your local server listens on (e.g. http://localhost:3000)
PORT=3000

# A friendly display name for the app
APP_NAME="Project Structure Guide"


# -----------------------------------------------------------------------------
# Secrets (replace with your own real values in .env)
# -----------------------------------------------------------------------------

# API key for an external service. Get yours from the service's dashboard.
# ⚠️ Treat this like a password!
API_KEY=your-api-key-here

# Connection string for a database
DATABASE_URL=postgres://username:password@localhost:5432/my_database

# A long random string used to sign login sessions/tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string


# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------

# How much detail to log: error, warn, info, debug
LOG_LEVEL=info
